# Datatek R0-B — variables de entorno de ejemplo.
# Sin secretos. Copia este archivo a .env.local (web/control comparten el
# monorepo pero cada app solo lee las variables que declara su propio schema
# Zod en src/lib/env.ts). R0-B no se conecta a Supabase ni a producción.

# ---------------------------------------------------------------------------
# apps/web — sitio público, Datatek Pro, Pass, Market y /a/[token]
# ---------------------------------------------------------------------------

# Entorno declarado explícitamente; nunca se infiere. "local" es el único
# valor permitido en R0-B — un valor "production" hace fallar el arranque
# porque no existe backend real que lo respalde todavía.
NEXT_PUBLIC_APP_ENV=local

# Puerto de apps/web (Next.js). Documentado, no usado por next dev/start
# directamente (se pasa como -p en package.json), pero validado para que
# scripts externos puedan leerlo de forma consistente.
WEB_PORT=3000

# URL pública base usada solo para construir enlaces absolutos en copy
# (nunca para llamadas de red reales en R0-B).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# apps/control — gobierno de plataforma, aplicación y sesión separadas
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CONTROL_APP_ENV=local
CONTROL_PORT=3001
NEXT_PUBLIC_CONTROL_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# apps/worker — placeholder inactivo en R0-B
# ---------------------------------------------------------------------------

WORKER_APP_ENV=local

# ---------------------------------------------------------------------------
# Reservado para R0-C/R0-D/R0-E — NO se usa en R0-B, documentado por
# adelantado para que el runbook de una sesión futura no tenga que
# redescubrir el nombre de la variable. No definir valores productivos aquí.
# ---------------------------------------------------------------------------

# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # nunca en un bundle de cliente; solo server-side en R0-C+
