{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "target": "ES2020",
    "outDir": "test-dist",
    "noEmit": false,
    "declaration": false,
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src", "test-setup"]
}
